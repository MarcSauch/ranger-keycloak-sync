# Keycloak connection
KEYCLOAK_BASE_URL=https://keycloak.example.com
KEYCLOAK_REALM=master
KEYCLOAK_CLIENT_ID=ranger-sync
KEYCLOAK_CLIENT_SECRET=change-me
KEYCLOAK_VERIFY_TLS=true
KEYCLOAK_PAGE_SIZE=200

# Ranger connection
RANGER_BASE_URL=http://ranger-admin:6080
RANGER_USERNAME=admin
RANGER_PASSWORD=admin
RANGER_SERVICE_NAME=cm_hive
RANGER_ROLE_PREFIX=kc_

# Sync behavior
SYNC_INTERVAL_SECONDS=86400
SYNC_ONCE=false
SYNC_REMOVE_MISSING_USERS=true
KEYCLOAK_ROLE_EXCLUDE=offline_access,uma_authorization

# Logging
LOG_LEVEL=INFO
