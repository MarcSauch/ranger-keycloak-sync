# Keycloak connection
KEYCLOAK_BASE_URL=https://keycloak.example.com
KEYCLOAK_REALM=master
KEYCLOAK_CLIENT_ID=ranger-sync
# Use 'client_credentials' (default) or 'password'
KEYCLOAK_GRANT_TYPE=client_credentials
# Required for client_credentials grant type
KEYCLOAK_CLIENT_SECRET=change-me
# Required for password grant type
KEYCLOAK_USERNAME=
KEYCLOAK_PASSWORD=
# Optional OAuth scope
KEYCLOAK_TOKEN_SCOPE=
KEYCLOAK_VERIFY_TLS=true
KEYCLOAK_PAGE_SIZE=200

# Ranger connection
RANGER_BASE_URL=http://ranger-admin:6080
RANGER_USERNAME=admin
RANGER_PASSWORD=admin
RANGER_SERVICE_NAME=cm_hive
RANGER_ROLE_PREFIX=kc_
RANGER_GROUP_PREFIX=
# Replace spaces/special characters in Keycloak usernames before Ranger calls
RANGER_NORMALIZE_USERNAMES=true
RANGER_USERNAME_SEPARATOR=_
# Normalize Keycloak group names/paths for Ranger-safe group names
RANGER_NORMALIZE_GROUP_NAMES=true
RANGER_GROUP_SEPARATOR=_

# Sync behavior
SYNC_INTERVAL_SECONDS=86400
SYNC_ONCE=false
SYNC_REMOVE_MISSING_USERS=true
KEYCLOAK_ROLE_EXCLUDE=offline_access,uma_authorization

# Logging
LOG_LEVEL=INFO
